# ==============================================================================
# SEGUROFLOW BACKEND — VARIÁVEIS DE AMBIENTE
# Creative Always — Configuração de Produção & Desenvolvimento
# ==============================================================================

# Servidor & Porta
PORT=3001
NODE_ENV=development

# Banco de Dados (PostgreSQL no Railway / Produção ou local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seguroflow?schema=public"

# Segurança & Autenticação (Chaves de 32+ bytes para produção)
JWT_SECRET="seguroflow_super_secret_jwt_key_creative_always_2026_change_in_prod"
JWT_EXPIRES_IN="7d"

# Chave mestra para criptografia AES-256-GCM de credenciais sensíveis no banco (ex.: Tokens Meta)
# IMPORTANTE: Deve conter exatamente 32 caracteres (256 bits)
ENCRYPTION_KEY="creativealways_seguroflow_key_32b"

# Provedores de IA
# Anthropic Claude (Orquestrador do Agente, Leitura de Documentos e Triagem de Sinistros)
ANTHROPIC_API_KEY=""

# OpenAI (Usado para transcrição rápida de notas de voz no WhatsApp via Whisper-1)
OPENAI_API_KEY=""

# Google Gemini (Opcional — fallback para visão computacional multimodal)
GEMINI_API_KEY=""

# Meta WhatsApp Cloud API — Configuração Geral
# A versão da Graph API suportada (padrão v21.0 ou superior)
WHATSAPP_GRAPH_API_VERSION="v21.0"

# CORS — Origens permitidas (painel do cliente e domínios autorizados)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,https://app.seguroflow.com.br"
