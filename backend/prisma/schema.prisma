generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  OWNER
  BROKER
  ATTENDANT
}

enum InsuranceBranch {
  AUTO
  RESIDENCIAL
  VIDA
  SAUDE
  EMPRESARIAL
  TRANSPORTE
  RURAL
  OUTROS
}

enum PolicyStatus {
  ACTIVE
  EXPIRING
  RENEWED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  SENT_D7
  SENT_D0
  SENT_D2
  PAID
  OVERDUE
  CLAIMED_PAID
}

enum ClaimStatus {
  OPEN
  DOCS_COLLECTED
  FORWARDED_TO_INSURER
  IN_ANALYSIS
  APPROVED
  REJECTED
  CLOSED
}

enum PipelineStage {
  NOVO
  COTACAO
  PROPOSTA
  EMISSAO
  POS_VENDA
}

enum RenewalWindow {
  DAYS_60
  DAYS_30
  DAYS_15
}

enum RenewalStatus {
  PENDING
  CONTACTED
  IN_NEGOTIATION
  RENEWED
  LOST
}

enum DocumentType {
  CNH
  CRLV
  APOLICE
}

enum ConversationStatus {
  AI_CONTROLLED
  HUMAN_CONTROLLED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
}

enum CallDraftStatus {
  PENDING
  CONFIRMED
  DISCARDED
}

enum CallIntentType {
  SINISTRO
  COTACAO
  RENOVACAO
  DUVIDA
  COBRANCA
  OUTRO
}

enum PolicyItemType {
  VEICULO
  CARRETA
  EMBARCACAO_CASCO
  OUTRO
}

enum PolicyItemStatus {
  ACTIVE
  EXCLUDED
}

enum AuthorizedContactRole {
  GESTOR_FROTA
  MOTORISTA
  FINANCEIRO
  SOCIO
  OUTRO
}

// =============================================================================
// MULTI-TENANT & CORRETORA
// =============================================================================

model Brokerage {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  cnpj      String?
  phone     String?
  email     String?
  active    Boolean  @default(true)

  // Integração Meta WhatsApp Cloud API Oficial (Isolada por Corretora)
  whatsappPhoneNumberId       String?  @unique
  whatsappBusinessAccountId   String?
  whatsappAccessTokenEncrypted String? // Criptografado AES-256-GCM
  whatsappAppSecretEncrypted   String? // Criptografado AES-256-GCM
  whatsappVerifyToken          String?

  // Configurações do Agente de IA
  agentEnabled   Boolean  @default(true)
  agentTone      String   @default("PROFISSIONAL_CORDIAL")
  alertPhone     String?  // WhatsApp do corretor para notificações urgentes de sinistro/transbordo

  // Telefonia Oficial & Gravação de Ligações (Isolada por Corretora)
  telephonyProvider            String?  // TWILIO, ZENVIA, TOTALVOICE, CUSTOM
  telephonyNumber              String?  // Número oficial contratado (DID/0800)
  telephonyForwardPhone        String?  // Celular/ramal do corretor para repasse
  telephonyQueue               Json?    // Fila ordenada de atendentes/telefones da equipe
  telephonyAccountSidEncrypted String?  // Criptografado AES-256-GCM
  telephonyAuthTokenEncrypted  String?  // Criptografado AES-256-GCM
  telephonyRecordingNotice     String?  @default("Esta ligação é gravada para agilizar o seu atendimento.")
  confirmedInsurers            Json?    // Telefones 24h confirmados pela corretora

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações Multi-tenant
  users          User[]
  insureds       Insured[]
  policies       Policy[]
  installments   Installment[]
  claims         Claim[]
  pipelineCards  PipelineCard[]
  renewals       RenewalTask[]
  documents      DocumentRecord[]
  conversations  Conversation[]
  calls          CallRecord[]
  auditLogs      AuditLog[]
  policyItems        PolicyItem[]
  authorizedContacts AuthorizedContact[]

  @@map("brokerages")
}

model User {
  id           String    @id @default(cuid())
  brokerageId  String
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(BROKER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brokerage    Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  assignedClaims Claim[]
  assignedCards  PipelineCard[]
  assignedRenewals RenewalTask[]
  assignedConversations Conversation[]
  assignedPolicies Policy[]
  auditLogs    AuditLog[]

  @@index([brokerageId])
  @@map("users")
}

// =============================================================================
// SEGURADOS & APÓLICES
// =============================================================================

model Insured {
  id          String    @id @default(cuid())
  brokerageId String
  name        String
  cpf         String?
  phone       String    // Formato E.164 (ex: 5527999998888)
  email       String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  brokerage   Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  policies    Policy[]
  claims      Claim[]
  pipelineCards PipelineCard[]
  documents   DocumentRecord[]
  conversations Conversation[]
  calls       CallRecord[]
  authorizedContacts AuthorizedContact[]

  @@index([brokerageId])
  @@index([phone])
  @@index([cpf])
  @@map("insureds")
}

model Policy {
  id                 String          @id @default(cuid())
  brokerageId        String
  insuredId          String
  policyNumber       String
  insurerName        String          // Ex: Porto Seguro, Allianz, Bradesco Seguros
  branch             InsuranceBranch @default(AUTO)
  assistance24hPhone String?         // Telefone 0800 / WhatsApp da assistência 24h da seguradora
  startDate          DateTime
  endDate            DateTime
  premiumAmount      Decimal         @db.Decimal(12, 2)
  commissionPercentage Decimal?      @db.Decimal(5, 2) // % negociado com a seguradora (ex: 15.00%)
  commissionAmount   Decimal?        @db.Decimal(12, 2) // Valor monetário estimado de comissão
  status             PolicyStatus    @default(ACTIVE)
  itemDescription    String?         // Ex: "Corolla Cross 2024 - Placa ABC1D23"
  subBranch          String?         // Ex: "Auto individual", "Frota", "RCTR-C", "RC-DC"
  assignedUserId     String?         // Corretor responsável pela apólice
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  brokerage    Brokerage       @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  insured      Insured         @relation(fields: [insuredId], references: [id], onDelete: Cascade)
  assignedUser User?           @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  installments Installment[]
  claims       Claim[]
  renewals     RenewalTask[]
  items        PolicyItem[]

  @@index([brokerageId])
  @@index([insuredId])
  @@index([assignedUserId])
  @@index([policyNumber])
  @@index([endDate])
  @@index([subBranch])
  @@map("policies")
}

// =============================================================================
// RÉGUA DE COBRANÇA PREVENTIVA (D-7, D-0, D+2)
// O dinheiro vai para a seguradora, nunca para a corretora ou Creative Always.
// =============================================================================

model Installment {
  id                String            @id @default(cuid())
  brokerageId       String
  policyId          String
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal           @db.Decimal(12, 2)
  paymentCode       String?           // Pix Copia e Cola ou Código de Barras emitido pela SEGURADORA
  pdfBoletoUrl      String?           // Link do boleto PDF emitido pela SEGURADORA
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?
  claimedPaidAt     DateTime?         // Data em que o segurado avisou "já paguei"
  claimedPaidNote   String?

  sentD7At          DateTime?
  sentD0At          DateTime?
  sentD2At          DateTime?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  policy    Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([brokerageId])
  @@index([policyId])
  @@index([dueDate])
  @@index([status])
  @@map("installments")
}

// =============================================================================
// CENTRAL DE SINISTROS (Módulo 1)
// =============================================================================

model Claim {
  id                   String      @id @default(cuid())
  brokerageId          String
  insuredId            String
  policyId             String
  incidentType         String      // Ex: "Colisão", "Furto/Roubo", "Alagamento", "Vidros"
  incidentDate         DateTime?
  incidentLocation     String?
  description          String
  status               ClaimStatus @default(OPEN)
  policeReportUrl      String?     // Link/path do B.O.
  photos               Json?       // Lista de URLs/IDs de fotos coletadas
  franchiseAmount      Decimal?    @db.Decimal(12, 2) // Valor da Franquia
  indemnityAmount      Decimal?    @db.Decimal(12, 2) // Valor pago de Indenização
  workshopName         String?     // Nome da Oficina / Reguladora credenciada
  cargoManifestNumber  String?     // CT-e / MDF-e / Manifesto (Transporte de Cargas)
  assistanceNotifiedAt DateTime?
  brokerNotifiedAt     DateTime?
  assignedUserId       String?
  policyItemId         String?     // Vínculo opcional ao veículo/item específico da frota
  isSimulation         Boolean     @default(false)

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  brokerage    Brokerage   @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  insured      Insured     @relation(fields: [insuredId], references: [id], onDelete: Cascade)
  policy       Policy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  assignedUser User?       @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  policyItem   PolicyItem? @relation(fields: [policyItemId], references: [id], onDelete: SetNull)

  @@index([brokerageId])
  @@index([status])
  @@index([policyItemId])
  @@index([isSimulation])
  @@map("claims")
}

// =============================================================================
// FUNIL DE VENDAS E ATENDIMENTO (Módulo 3)
// =============================================================================

model PipelineCard {
  id             String        @id @default(cuid())
  brokerageId    String
  insuredId      String?
  title          String        // Ex: "Renovação Auto - João Silva" ou "Cotação Frota"
  value          Decimal?      @db.Decimal(12, 2)
  stage          PipelineStage @default(NOVO)
  stageEnteredAt DateTime      @default(now())
  slaHours       Int           @default(24) // SLA em horas para alerta de estorno
  source         String?       // WhatsApp, Indicação, Google, Site
  notes          String?
  assignedUserId String?
  isSimulation   Boolean       @default(false)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  brokerage    Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  insured      Insured?  @relation(fields: [insuredId], references: [id], onDelete: SetNull)
  assignedUser User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([brokerageId])
  @@index([stage])
  @@index([isSimulation])
  @@map("pipeline_cards")
}

// =============================================================================
// RENOVAÇÕES (Módulo 4: 60, 30 e 15 dias)
// =============================================================================

model RenewalTask {
  id             String        @id @default(cuid())
  brokerageId    String
  policyId       String
  alertWindow    RenewalWindow
  status         RenewalStatus @default(PENDING)
  lostReason     String?       // "PRECO", "VENDEU_BEM", "FECHOU_BANCO", "FECHOU_OUTRA_CORRETORA", "SEM_CONTATO", "OUTRO"
  lostNotes      String?       // Detalhes da perda (quando OUTRO ou observação adicional)
  assignedUserId String?
  lastContactAt  DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  brokerage    Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  policy       Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([brokerageId])
  @@index([policyId])
  @@index([status])
  @@map("renewal_tasks")
}

// =============================================================================
// LEITURA DE DOCUMENTOS POR IA (Módulo 5: CNH, CRLV, Apólices)
// =============================================================================

model DocumentRecord {
  id            String       @id @default(cuid())
  brokerageId   String
  insuredId     String?
  docType       DocumentType
  fileName      String
  fileUrl       String
  extractedData Json         // Campos estruturados extraídos via Vision AI
  validated     Boolean      @default(false)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  insured   Insured?  @relation(fields: [insuredId], references: [id], onDelete: SetNull)

  @@index([brokerageId])
  @@map("document_records")
}

// =============================================================================
// CONVERSAS & MENSAGENS (Atendimento WhatsApp Cloud API)
// =============================================================================

model Conversation {
  id          String             @id @default(cuid())
  brokerageId String
  insuredId   String?
  phone       String
  status      ConversationStatus @default(AI_CONTROLLED)
  humanReason String?
  assignedUserId String?
  unreadCount Int                @default(0)
  isSimulation Boolean           @default(false)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  brokerage    Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  insured      Insured?  @relation(fields: [insuredId], references: [id], onDelete: SetNull)
  assignedUser User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@index([brokerageId])
  @@index([phone])
  @@index([assignedUserId])
  @@index([isSimulation])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  text           String
  mediaUrl       String?
  mediaType      String?          // image, audio, document
  externalId     String?          // wamid da Meta
  sentAt         DateTime         @default(now())
  isSimulation   Boolean          @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([isSimulation])
  @@map("messages")
}

// =============================================================================
// LGPD & LOGS DE AUDITORIA
// =============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  brokerageId String
  userId      String?
  action      String   // Ex: "VIEW_INSURED", "EXPORT_PORTFOLIO", "UPDATE_META_CREDENTIALS", "DELETE_INSURED"
  resource    String   // Ex: "Insured:cl123..."
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([brokerageId])
  @@index([action])
  @@map("audit_logs")
}

// =============================================================================
// LIGAÇÕES TELEFÔNICAS & GRAVAÇÕES TRANSCRITAS (Telefonia Oficial / PABX)
// =============================================================================

model CallRecord {
  id              String          @id @default(cuid())
  brokerageId     String
  insuredId       String?
  fromPhone       String          // Telefone de quem ligou
  toPhone         String          // Número da corretora
  forwardedTo     String?         // Celular/ramal que atendeu
  direction       CallDirection   @default(INBOUND)
  status          CallStatus      @default(COMPLETED)
  durationSeconds Int             @default(0)
  recordingUrl            String?         // URL do áudio no provedor de telefonia
  recordingFile           String?         // Nome do arquivo se enviado via upload manual
  recordingAudioEncrypted String?         @db.Text // Cópia binária criptografada (AES-256-GCM) para reprodução protegida
  transcription           String?         @db.Text // Transcrição integral gerada via Whisper
  summary         String?         @db.Text // Resumo executivo de 2 linhas pela IA
  intent          CallIntentType? // Intenção classificada pela IA (SINISTRO, COTACAO, RENOVACAO, etc.)
  extractedData   Json?           // Dados estruturados { insurer, policyNumber, plate, location, urgency, nextSteps }
  draftStatus     CallDraftStatus @default(PENDING) // PENDING -> CONFIRMED -> DISCARDED
  estimatedCost   Decimal?        @db.Decimal(10, 4) // Custo estimado (entrada, repasse, gravação, transcrição, IA)
  createdClaimId  String?         // ID do sinistro gerado a partir desta ligação
  createdCardId   String?         // ID do card de pipeline gerado a partir desta ligação

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  insured   Insured?  @relation(fields: [insuredId], references: [id], onDelete: SetNull)

  @@index([brokerageId])
  @@index([fromPhone])
  @@index([draftStatus])
  @@map("call_records")
}

// =============================================================================
// ITENS DA APÓLICE (FROTA, CARRETAS, CASCO)
// =============================================================================

model PolicyItem {
  id             String           @id @default(cuid())
  brokerageId    String
  policyId       String
  type           PolicyItemType   @default(VEICULO)
  plate          String?          // Placa do veículo/carreta (ex: ABC1D23)
  chassis        String?          // Chassi
  makeModel      String?          // Marca e Modelo (ex: Scania R450, Hilux CD)
  year           Int?             // Ano fabricação/modelo
  identification String?          // Identificação livre (ex: "Cavalo mecânico 04")
  status         PolicyItemStatus @default(ACTIVE)
  inclusionDate  DateTime?        // Data de inclusão (endosso)
  exclusionDate  DateTime?        // Data de exclusão (endosso)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  policy    Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  claims    Claim[]

  @@index([brokerageId])
  @@index([policyId])
  @@index([plate])
  @@index([status])
  @@map("policy_items")
}

// =============================================================================
// CONTATOS AUTORIZADOS DO SEGURADO (MOTORISTA, GESTOR DE FROTA, FINANCEIRO)
// =============================================================================

model AuthorizedContact {
  id          String                @id @default(cuid())
  brokerageId String
  insuredId   String
  name        String
  phone       String                // Formato E.164
  role        AuthorizedContactRole @default(MOTORISTA)
  canClaims   Boolean               @default(true)  // Receber kit de sinistro / abrir sinistro
  canBilling  Boolean               @default(false) // Receber cobrança / boleto / dados financeiros
  canRenewal  Boolean               @default(false) // Tratar renovação
  notes       String?

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  insured   Insured   @relation(fields: [insuredId], references: [id], onDelete: Cascade)

  @@index([brokerageId])
  @@index([insuredId])
  @@index([phone])
  @@map("authorized_contacts")
}


